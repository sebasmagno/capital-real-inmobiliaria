generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  type      String   @default("Agente") // "Agente", "Administrativo", "Ambos"
  imageUrl  String?
  phone     String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  properties Property[]
  leads      Lead[]
}

model Property {
  id                String   @id @default(uuid())
  code              String?
  title             String
  description       String?
  price             Float
  adminFee          Float?
  location          String
  latitude          Float?
  longitude         Float?
  type              String
  status            String   // "Venta", "Alquiler"
  propertyCondition String?  @default("Excelente") // "Sobre planos", "Para estrenar", "Excelente", "Remodelado", "Para remodelar"
  bedrooms          Int
  bathrooms         Int
  garages           Int      @default(0)
  area              Float
  builtArea         Float?
  stratum           Int?
  floor             Int?
  yearBuilt         Int?
  amenities         String[] @default([])
  videoUrl          String?
  virtualTourUrl    String?
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agentId     String
  agent       User     @relation(fields: [agentId], references: [id])
  
  images      Image[]
  leads       Lead[]
}

model Image {
  id         String   @id @default(uuid())
  url        String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Lead {
  id              String    @id @default(uuid())
  name            String
  email           String
  phone           String?
  message         String
  source          String    @default("WEB_CONTACTO") // "WEB_PROPIEDAD", "WHATSAPP_PROPIEDAD", "WEB_CONTACTO", "WHATSAPP_CONTACTO"
  status          String    @default("NUEVO")        // "NUEVO", "CONTACTADO", "VISITA_AGENDADA", "EN_NEGOCIACION", "CERRADO", "DESCARTADO"
  preferredDate   DateTime?
  notes           String?
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedAgentId String?
  assignedAgent   User?     @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Settings {
  id           String   @id @default("singleton")
  companyName  String   @default("CAPITAL REAL INMOBILIARIA")
  contactEmail String   @default("info@capitalreal.com")
  phone        String   @default("+57 300 000 0000")
  address      String   @default("Pereira, Risaralda, Colombia")
  logoUrl      String?
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  businessHours String   @default("Lunes a Viernes, 9am - 6pm")
  updatedAt    DateTime @updatedAt
}
