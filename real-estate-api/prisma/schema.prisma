generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  type      String   @default("Agente") // "Agente", "Administrativo", "Ambos"
  imageUrl  String?
  phone     String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  properties Property[]
}

model Property {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float
  location    String
  type        String
  status      String   // "Venta", "Alquiler"
  bedrooms    Int
  bathrooms   Int
  area        Float
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agentId     String
  agent       User     @relation(fields: [agentId], references: [id])
  
  images      Image[]
}

model Image {
  id         String   @id @default(uuid())
  url        String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Settings {
  id           String   @id @default("singleton")
  companyName  String   @default("CAPITAL REAL INMOBILIARIA")
  contactEmail String   @default("info@capitalreal.com")
  phone        String   @default("+57 300 000 0000")
  address      String   @default("Pereira, Risaralda, Colombia")
  logoUrl      String?
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  businessHours String   @default("Lunes a Viernes, 9am - 6pm")
  updatedAt    DateTime @updatedAt
}
